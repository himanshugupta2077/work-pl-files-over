& {
    $root = Join-Path ([Environment]::GetFolderPath('Desktop')) 'PL-ZT-Pilot\pl-pilot-ca.cer'
    $ca = [Security.Cryptography.X509Certificates.X509Certificate2]::new($root)
    $sha = [Security.Cryptography.SHA256]::Create()
    $hash = [BitConverter]::ToString($sha.ComputeHash($ca.RawData)).Replace('-', '')
    $sha.Dispose()
    if ($hash -ne '0EB6B9C760EE3342B17A7156DF2A0156991415139D57EA266BE08EE35FA7EDFE') {
        throw 'Certificate mismatch. Stop.'
    }
    certutil.exe -user -addstore Root $root
    if ($LASTEXITCODE -ne 0) { throw 'Trust installation failed.' }
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$env:USERPROFILE\Downloads\install-pilot-certificate.ps1"
}
